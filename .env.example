# YASH Configuration
# Copy to .env and fill in your values

# === LLM Settings ===
# OPENAI_API_KEY=sk-your-key-here
# Or use alternative endpoint:
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4

# === Memory ===
MAX_TOKENS=4000
MEMORY_FILE=./messages.log

# === Heartbeat ===
HEARTBEAT_INTERVAL=30

# === Workspace ===
WORKSPACE_DIR=./workspace